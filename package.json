{
  "name": "answer-everything",
  "version": "0.1.0",
  "private": true,
  "description": "Answer Everything: a model-agnostic intelligence platform. Ask anything. Get the strongest available answer.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm run --parallel --filter ./apps/* --filter ./tools/* dev",
    "dev:api": "pnpm --filter @ae/api dev",
    "dev:web": "pnpm --filter @ae/web dev",
    "dev:worker": "pnpm --filter @ae/worker dev",
    "dev:provider": "pnpm --filter @ae/dev-provider dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* --filter ./tools/* build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:authorization": "vitest run --project authorization",
    "db:migrate": "pnpm --filter @ae/database migrate",
    "db:seed": "pnpm --filter @ae/model-registry seed",
    "db:reset": "pnpm --filter @ae/database reset",
    "eval": "pnpm --filter @ae/evaluation run-suite"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
