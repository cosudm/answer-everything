# ---------------------------------------------------------------------------
# Answer Everything: local development environment
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

AE_ENV=dev                                  # dev | uat | prod
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Migrator / owner connection (runs migrations, owns schema).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/answer_everything
# Application connection. Must be the ae_app role (RLS enforced, no BYPASSRLS).
DATABASE_APP_URL=postgres://ae_app:ae_app_dev_password@localhost:5432/answer_everything
# Identity connection. ae_identity may read users/sessions before a workspace
# context exists (login, session resolution). Nothing else uses it.
DATABASE_IDENTITY_URL=postgres://ae_identity:ae_identity_dev_password@localhost:5432/answer_everything
# Passwords the migration uses when creating the roles above (dev only).
AE_DB_APP_PASSWORD=ae_app_dev_password
AE_DB_IDENTITY_PASSWORD=ae_identity_dev_password

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# 32+ random bytes, base64. Used to HMAC session tokens at rest.
AE_SESSION_SECRET=change-me-dev-session-secret-change-me-0000000000
AE_SESSION_TTL_MINUTES=30
AE_REFRESH_TTL_DAYS=14
AE_COOKIE_SECURE=false

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Model providers ----------------------------------------------------------
# Provider credentials are resolved server-side by the Credential Broker from
# the environment variable named in each provider's credentialRef. They are
# never stored in the database and never sent to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
# OpenAI-compatible private inference (vLLM, TGI, RunPod, Together, ...)
PRIVATE_INFERENCE_BASE_URL=
PRIVATE_INFERENCE_API_KEY=
# Ollama (local development only)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Local development provider (tools/dev-provider). This is a labelled stub that
# speaks the OpenAI-compatible protocol so the full Ask pipeline can be
# exercised without external keys. It is registered as deploymentType=LOCAL,
# evaluationStatus=TESTING and is never enabled when AE_ENV=prod.
DEV_PROVIDER_BASE_URL=http://localhost:4100/v1
DEV_PROVIDER_PORT=4100

# Model seed file (see config/models.seed.json)
AE_MODEL_SEED_PATH=./config/models.seed.json

# --- Budgets / limits ---------------------------------------------------------
AE_DEFAULT_WORKSPACE_MONTHLY_BUDGET_USD=25
AE_RATE_LIMIT_PER_MINUTE=120
AE_MAX_UPLOAD_BYTES=10485760

# --- Observability ------------------------------------------------------------
LOG_LEVEL=info
OTEL_SERVICE_NAME=answer-everything-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Dev only: new workspaces may select TESTING/EXPERIMENTAL models (needed for the
# local stub). The API refuses to start with this true when AE_ENV=prod.
AE_DEFAULT_ALLOW_EXPERIMENTAL=true
# Run background jobs inline in the API process (handy without a worker).
AE_INLINE_JOBS=false
# Embedding model as provider-slug/model-name. Switch to openai/text-embedding-3-small with a key.
AE_EMBEDDING_MODEL=local-dev/dev-embed-1536

# Who may create an account: comma-separated addresses and @domains, for example
# "ada@example.com, @yourcompany.com". Empty means anyone. Set it before a
# public environment gets a paid provider key.
AE_SIGNUP_ALLOWLIST=

# --- Single-container deployments (Cloudflare, demos) -------------------------
# Run the job runner inside the API process instead of a separate worker.
AE_EMBEDDED_WORKER=false
# Run the labelled development provider inside the API process (never in prod).
AE_EMBEDDED_DEV_PROVIDER=false
# Container entrypoint only: with no DATABASE_URL, start a PostgreSQL inside the
# API container. Needs the image built with RUNTIME_BASE=pgvector/pgvector:pg16.
# Everything stored is erased when the container stops. Refused when AE_ENV=prod.
AE_EMBEDDED_DATABASE=false
# Set by that entrypoint, not by hand: makes /health report storage "ephemeral".
# AE_STORAGE_EPHEMERAL=true

