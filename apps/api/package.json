{
  "name": "@ae/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --packages=external --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ae/authorization": "workspace:*",
    "@ae/database": "workspace:*",
    "@ae/domain": "workspace:*",
    "@ae/evaluation": "workspace:*",
    "@ae/events": "workspace:*",
    "@ae/identity": "workspace:*",
    "@ae/knowledge": "workspace:*",
    "@ae/model-gateway": "workspace:*",
    "@ae/model-registry": "workspace:*",
    "@ae/observability": "workspace:*",
    "@ae/orchestration": "workspace:*",
    "@ae/provenance": "workspace:*",
    "@ae/research": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "fastify-plugin": "5.1.0",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ae/dev-provider": "workspace:*",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2"
  }
}
